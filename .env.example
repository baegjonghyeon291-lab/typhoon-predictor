# ------------------------------------------------------------------
# typhoon-predictor 외부 자료 키 예시
# 이 파일을 복사해 .env 로 만들고(cp .env.example .env) 값만 채우세요.
# .env 는 .gitignore 에 들어 있어 git 에 올라가지 않습니다.
# 값에 따옴표는 필요 없습니다.  예) CDS_API_KEY=1234abcd-....
# ------------------------------------------------------------------


# ==================================================================
# 1) CDS_API_KEY — ECMWF Copernicus Climate Data Store (ERA5 재분석 자료)
#    사용처: python -m typhoon.sources.era5
#    비용: 무료
#    발급 절차:
#      1. https://cds.climate.copernicus.eu 접속 → 오른쪽 위 [Login - Register]
#         → ECMWF 계정 만들기(이메일 인증). 가입 즉시 사용 가능.
#      2. 로그인 후 https://cds.climate.copernicus.eu/profile 에서
#         'Personal Access Token' 값을 복사해 아래에 붙여넣기.
#         (새 CDS 는 토큰 하나만 쓴다. 예전의 'UID:키' 형식 아님)
#      3. 꼭 해야 하는 것: https://cds.climate.copernicus.eu/datasets/reanalysis-era5-pressure-levels?tab=download
#         페이지 맨 아래 'Terms of use' 에서 라이선스에 동의(Accept).
#         동의 안 하면 키가 맞아도 다운로드가 거부됩니다.
#    API 주소: https://cds.climate.copernicus.eu/api  (코드에 들어 있음)
#    필요 패키지: .venv/bin/pip install "cdsapi>=0.7.7"
# ==================================================================
CDS_API_KEY=


# ==================================================================
# 2) KMA_APIHUB_KEY — 기상청 API허브 (태풍 예보 발표 이력: 발표번호별 분석·예측 진로)
#    사용처: python -m typhoon.sources.kma typhoon
#    비용: 무료
#    발급 절차:
#      1. https://apihub.kma.go.kr 접속 → 회원가입 → 로그인
#      2. 상단 메뉴 '태풍' (https://apihub.kma.go.kr/apiList.do?seqApi=8) 이동
#      3. '1. 태풍정보(기상청 발표) 조회' 의 [API 활용신청] 버튼 → 신청서 작성
#      4. 마이페이지에서 인증키(authKey) 확인 후 아래에 붙여넣기
#         (한 계정의 인증키 하나로, 활용신청한 여러 API 를 같이 씁니다)
#    쓰는 주소:
#      https://apihub.kma.go.kr/api/typ01/url/typ_lst.php?YY=연도&disp=1&help=0&authKey=키
#      https://apihub.kma.go.kr/api/typ01/url/typ_data.php?YY=연도&typ=태풍번호&mode=3&disp=1&help=0&authKey=키
# ==================================================================
KMA_APIHUB_KEY=


# ==================================================================
# 3) DATA_GO_KR_KEY — 공공데이터포털 (ASOS 일자료 + 태풍정보 예비 경로)
#    사용처: python -m typhoon.sources.kma asos
#            python -m typhoon.sources.kma typhoon --via datagokr
#    비용: 무료.  개발계정 하루 10,000회 호출
#    발급 절차:
#      1. https://www.data.go.kr 회원가입(본인인증) → 로그인
#      2. 아래 두 페이지에서 각각 [활용신청] → 활용목적 간단히 적고 신청
#         (두 서비스 모두 '개발단계: 자동승인' 이라 신청 즉시 승인)
#           - 기상청_지상(종관, ASOS) 일자료 조회서비스: https://www.data.go.kr/data/15059093/openapi.do
#           - 기상청_태풍정보 조회서비스:               https://www.data.go.kr/data/15043565/openapi.do
#      3. 마이페이지 → 데이터활용 → Open API → 활용신청 현황 → 해당 서비스 클릭
#         → '일반 인증키(Decoding)' 값을 복사해 아래에 붙여넣기
#         (Encoding 키를 넣어도 코드가 알아서 풀어 씁니다)
#      ※ 승인 직후에는 키가 반영되기까지 시간이 걸려 'SERVICE_KEY_IS_NOT_REGISTERED_ERROR' 가
#        날 수 있습니다. 잠시(보통 수십 분~1시간, 길면 하루) 뒤 다시 실행하세요.
# ==================================================================
DATA_GO_KR_KEY=


# ------------------------------------------------------------------
# 일본 기상청 자료(python -m typhoon.sources.jma)는 키가 필요 없습니다.
# ------------------------------------------------------------------
